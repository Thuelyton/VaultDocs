{
  "name": "vaultdocs",
  "version": "1.0.0",
  "description": "VaultDocs - Secure Document Management System",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "start:mobile": "npm run start --workspace=apps/mobile",
    "lint": "npm run lint --workspace=apps/api",
    "typecheck": "npm run typecheck --workspace=apps/api",
    "install:all": "npm install"
  },
  "keywords": [
    "vaultdocs",
    "document-management",
    "react-native",
    "express",
    "mongodb"
  ],
  "author": "VaultDocs Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
