# ===========================================
# VaultDocs API - Environment Variables
# ===========================================
# This is a TEMPLATE. Copy to .env and fill in real values.
# NEVER commit real secrets. Rotate immediately if exposed.
# ===========================================

# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaultdocs?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace-with-long-random-secret-min-32-chars

# Cloudflare R2 Configuration
# Create a bucket in Cloudflare Dashboard -> R2 -> Create bucket
# Create API token in R2 -> Manage R2 API Tokens -> Object Read & Write
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vaultdocs-storage
# Optional: only if you enabled a public dev URL on the bucket
R2_PUBLIC_URL=https://your-bucket.your-account-id.r2.dev

# Google Gemini AI Configuration (optional - uploads work without it)
GEMINI_API_KEY=your_gemini_api_key

# CORS: comma-separated list of allowed origins (e.g. https://your-app.vercel.app)
CORS_ORIGIN=https://your-app.vercel.app
