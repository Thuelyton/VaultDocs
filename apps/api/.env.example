# ===========================================
# VaultDocs API - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3000

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaultdocs?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Optional: CORS Configuration
# CORS_ORIGIN=http://localhost:8081

# Optional: Cloudflare R2 / AWS S3 (for file storage)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=vaultdocs-storage
# R2_PUBLIC_URL=https://your-bucket.r2.dev
