# ===========================================
# VaultDocs API - Environment Variables
# ===========================================
# TEMPLATE. Copy to .env (or fill in on Render dashboard).
# NEVER commit real secrets. Rotate keys immediately if exposed.
# ===========================================

# --- Server ---
PORT=3000
NODE_ENV=production

# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers (Node.js 5.5+)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaultdocs?retryWrites=true&w=majority

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32-byte-random-hex-string

# --- Cloudflare R2 ---
# 1) Create bucket "vaultdocs-api" (or any name you prefer) in Cloudflare -> R2
# 2) R2 -> Manage R2 API Tokens -> Create token
#    Permissions: Object Read & Write on the bucket above
# 3) Account ID: Cloudflare dashboard -> R2 -> right sidebar
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vaultdocs-api
# In production we use presigned URLs only, so leave this empty.
R2_PUBLIC_URL=

# --- Google Gemini AI (optional) ---
# https://aistudio.google.com/app/apikey
# If absent, uploads still work — AI extraction is skipped.
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated list. In production set this to your Vercel URL.
CORS_ORIGIN=https://your-app.vercel.app
