# ===========================================
# VaultDocs API - Environment Variables
# ===========================================

# Server Configuration
PORT=3000

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaultdocs?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=vaultdocs-storage
R2_PUBLIC_URL=https://your-bucket-name.your-account-id.r2.dev

# Optional: CORS Configuration
# CORS_ORIGIN=http://localhost:8081
